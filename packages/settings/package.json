{
  "name": "@mini-harness/settings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/server/api.ts",
    "./browser/api": "./src/browser/api.ts",
    "./config": "./src/server/config.ts",
    "./manager": "./src/server/manager.ts",
    "./manifest": "./src/manifest.ts",
    "./settings": "./src/shared/settings.ts"
  },
  "miniHarness": {
    "api": [
      "./api",
      "./browser/api",
      "./settings"
    ],
    "profileModules": {
      "@mini-harness/settings-runtime": "./src/server/runtime.ts",
      "@mini-harness/ui-settings": "./src/manifest.ts#manifest"
    }
  },
  "dependencies": {
    "@mini-harness/llm": "workspace:*",
    "@mini-harness/platform": "workspace:*",
    "@mini-harness/plugin-api": "workspace:*",
    "@mini-harness/transport": "workspace:*",
    "@mini-harness/ui-layout": "workspace:*",
    "@mini-harness/ui-primitives": "workspace:*",
    "@mini-harness/ui-runtime": "workspace:*",
    "@mini-harness/ui-theme": "workspace:*"
  }
}
