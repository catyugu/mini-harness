{
  "name": "@mini-harness/file-preview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": "./src/manifest.ts",
    "./browser/api": "./src/browser/api.ts"
  },
  "dependencies": {
    "@mini-harness/file-access": "workspace:*",
    "@mini-harness/platform": "workspace:*",
    "@mini-harness/plugin-api": "workspace:*",
    "@mini-harness/transport": "workspace:*",
    "@mini-harness/ui-layout": "workspace:*",
    "@mini-harness/ui-primitives": "workspace:*",
    "@mini-harness/ui-runtime": "workspace:*"
  },
  "miniHarness": {
    "api": [
      "./browser/api"
    ],
    "profileModules": {
      "@mini-harness/file-preview": "./src/manifest.ts#manifest"
    }
  }
}
