{
  "name": "mini-harness",
  "version": "0.1.0",
  "description": "A minimal, plugin-first Web harness for Pi",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mini-harness": "./dist/bin/mini-harness.js"
  },
  "files": [
    "dist/",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node dist/scripts/copy-assets.js",
    "start": "npm run build && node dist/bin/mini-harness.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "cordis": "4.0.0-rc.13",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catyugu/mini-harness.git"
  },
  "keywords": [
    "pi",
    "agent",
    "harness",
    "web",
    "plugins"
  ]
}
