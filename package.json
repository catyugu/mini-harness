      "default": "./dist/packages/llm/src/vocabulary.js"
    },
    "./models": {
      "types": "./dist/types/packages/models/src/server/api.d.ts",
      "default": "./dist/packages/models/src/server/api.js"
    },
    "./models/catalog": {
      "types": "./dist/types/packages/models/src/shared/catalog.d.ts",
      "default": "./dist/packages/models/src/shared/catalog.js"
    },
    "./observations": {
      "types": "./dist/types/packages/plugin-api/src/observations.d.ts",
      "default": "./dist/packages/plugin-api/src/observations.js"
    },
    "./plugin-data": {
      "types": "./dist/types/packages/plugin-api/src/services.d.ts",
