{
  "name": "mini-harness",
  "version": "0.4.0",
  "description": "A minimal, plugin-first Web harness with a native agent kernel",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mini-harness": "./dist/bin/mini-harness.js"
  },
  "files": [
    "dist/bin/",
    "dist/packages/",
    "dist/types/packages/contracts/",
    "dist/types/packages/ui-runtime/frontend.d.ts",
    "dist/types/packages/ui-runtime/plugin-sdk.d.ts",
    "dist/types/packages/ui-runtime/settings.d.ts",
    "dist/types/packages/ui-slots/registry.d.ts",
    "dist/types/packages/web/contracts/",
    "dist/types/packages/web/vendor/cordis.d.ts",
    "!dist/**/tests/**",
    "!dist/**/*.test.js",
    "!dist/**/*.spec.js",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json && node scripts/resolve-imports.mjs && node dist/scripts/copy-assets.js",
    "start": "pnpm run build && node dist/bin/mini-harness.js",
    "test": "pnpm run build && node dist/scripts/run-node-tests.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck && npm test",
    "pack:check": "pnpm run build && node dist/scripts/check-package.js",
    "test:browser": "pnpm run build && playwright test -c playwright.config.ts",
    "check:deps": "pnpm run build && node --test dist/test/system/architecture.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "cordis": "4.0.0-rc.13",
    "ignore": "7.0.8",
    "re2-wasm": "1.0.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.15.0",
    "dompurify": "3.4.18",
    "marked": "18.2.1",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catyugu/mini-harness.git"
  },
  "keywords": [
    "pi",
    "agent",
    "harness",
    "web",
    "plugins"
  ],
  "exports": {
    "./plugin": {
      "types": "./dist/types/packages/contracts/plugin-sdk.d.ts",
      "default": "./dist/packages/contracts/plugin-sdk.js"
    },
    "./browser-plugin": {
      "types": "./dist/types/packages/ui-runtime/plugin-sdk.d.ts",
      "default": "./dist/packages/ui-runtime/plugin-sdk.js"
    }
  },
  "packageManager": "pnpm@10.34.9"
}
