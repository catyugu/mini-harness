      "default": "./dist/packages/sessions/src/records.js"
    },
    "./sessions/identity": {
      "types": "./dist/types/packages/sessions/src/shared/identity.d.ts",
      "default": "./dist/packages/sessions/src/shared/identity.js"
    },
    "./sessions/run-state": {
      "types": "./dist/types/packages/sessions/src/shared/run-state.d.ts",
      "default": "./dist/packages/sessions/src/shared/run-state.js"
    },
    "./sessions/display-record": {
      "types": "./dist/types/packages/sessions/src/shared/display-record.d.ts",
      "default": "./dist/packages/sessions/src/shared/display-record.js"
    },
    "./tools": {
      "types": "./dist/types/packages/tools/src/api.d.ts",
      "default": "./dist/packages/tools/src/api.js"
    },
    "./tools/events": {
      "types": "./dist/types/packages/tools/src/events.d.ts",
      "default": "./dist/packages/tools/src/events.js"
    },
    "./transport": {
      "types": "./dist/types/packages/transport/src/routes.d.ts",
      "default": "./dist/packages/transport/src/routes.js"
    },
    "./ui-layout": {
      "types": "./dist/types/packages/ui-layout/src/browser/api.d.ts",
      "default": "./dist/packages/ui-layout/src/browser/api.js"
    },
    "./ui-primitives": {
      "types": "./dist/types/packages/ui-primitives/src/browser/api.d.ts",
      "default": "./dist/packages/ui-primitives/src/browser/api.js"
    },
    "./ui-runtime/http": {
      "types": "./dist/types/packages/ui-runtime/src/browser/http.d.ts",
      "default": "./dist/packages/ui-runtime/src/browser/http.js"
    },
    "./ui-runtime/plugin-settings": {
      "types": "./dist/types/packages/ui-runtime/src/browser/plugin-settings.d.ts",
