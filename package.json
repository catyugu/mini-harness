{
  "name": "mini-harness",
  "version": "0.4.0",
  "description": "A minimal, plugin-first Web harness with a native agent kernel",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mini-harness": "./dist/bin/mini-harness.js"
  },
  "files": [
    "dist/bin/",
    "dist/packages/",
    "profiles/",
    "dist/vendor/",
    "dist/types/vendor/",
    "dist/types/packages/",
    "!dist/**/tests/**",
    "!dist/**/*.test.js",
    "!dist/**/*.spec.js",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json && node --experimental-strip-types scripts/resolve-imports.ts && node dist/scripts/copy-assets.js && node dist/scripts/prune-sdk.js && tsc -p docs/examples/tsconfig.json",
    "start": "pnpm run build && node dist/bin/mini-harness.js",
    "test": "pnpm run build && pnpm run test:node",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run format:check && pnpm run test",
    "pack:check": "pnpm run build && pnpm run pack:verify",
    "test:browser": "pnpm run build && pnpm run test:playwright",
    "check:deps": "pnpm run build && node --test dist/test/system/architecture.test.js",
    "test:node": "node dist/scripts/run-node-tests.js",
    "pack:verify": "node dist/scripts/check-package.js",
    "test:playwright": "playwright test -c playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@standard-schema/spec": "1.1.0",
    "ignore": "7.0.8",
    "re2-wasm": "1.0.2",
    "semver": "7.7.4",
    "typebox": "1.3.27",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@mini-harness/file-access": "workspace:*",
    "@mini-harness/host": "workspace:*",
    "@mini-harness/input": "workspace:*",
    "@mini-harness/llm": "workspace:*",
    "@mini-harness/platform": "workspace:*",
    "@mini-harness/plugin-api": "workspace:*",
    "@mini-harness/plugins": "workspace:*",
    "@mini-harness/runs": "workspace:*",
    "@mini-harness/sandbox": "workspace:*",
    "@mini-harness/sessions": "workspace:*",
    "@mini-harness/settings": "workspace:*",
    "@mini-harness/tools": "workspace:*",
    "@mini-harness/ui-runtime": "workspace:*",
    "@mini-harness/workspaces": "workspace:*",
    "@playwright/test": "1.56.0",
    "@types/node": "^22.15.0",
    "@types/semver": "^7.7.0",
    "dompurify": "3.4.18",
    "esbuild": "0.25.12",
    "marked": "18.2.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catyugu/mini-harness.git"
  },
  "keywords": [
    "pi",
    "agent",
    "harness",
    "web",
    "plugins"
  ],
  "exports": {
    "./cordis": {
      "types": "./dist/types/vendor/cordis-runtime/src/index.d.ts",
      "default": "./dist/vendor/cordis-runtime/src/index.js"
    },
    "./agent": {
      "types": "./dist/types/packages/agent/src/api.d.ts",
      "default": "./dist/packages/agent/src/api.js"
    },
    "./agent/events": {
      "types": "./dist/types/packages/agent/src/events.d.ts",
      "default": "./dist/packages/agent/src/events.js"
    },
    "./agent/prompt": {
      "types": "./dist/types/packages/agent/src/prompt-api.d.ts",
      "default": "./dist/packages/agent/src/prompt-api.js"
    },
    "./approvals": {
      "types": "./dist/types/packages/approvals/src/server/api.d.ts",
      "default": "./dist/packages/approvals/src/server/api.js"
    },
    "./conversation/display-events": {
