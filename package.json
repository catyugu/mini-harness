      "default": "./dist/packages/file-access/src/api.js"
    },
    "./file-preview": {
      "types": "./dist/types/packages/file-preview/src/browser/api.d.ts",
      "default": "./dist/packages/file-preview/src/browser/api.js"
    },
    "./input": {
      "types": "./dist/types/packages/input/src/message.d.ts",
      "default": "./dist/packages/input/src/message.js"
    },
    "./llm": {
