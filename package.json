{
  "name": "mini-harness",
  "version": "0.3.0",
  "description": "A minimal, plugin-first Web harness for Pi",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mini-harness": "./dist/bin/mini-harness.js"
  },
  "files": [
    "dist/bin/",
    "dist/src/",
    "dist/web/",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node dist/scripts/copy-assets.js",
    "start": "npm run build && node dist/bin/mini-harness.js",
    "test": "npm run build && node --import ./dist/test/helpers/isolate-home.js --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm run build && node dist/scripts/check-package.js",
    "test:browser": "npm run build && playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "cordis": "4.0.0-rc.13",
    "ignore": "7.0.8",
    "re2-wasm": "1.0.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.15.0",
    "dompurify": "3.4.18",
    "marked": "18.2.1",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/catyugu/mini-harness.git"
  },
  "keywords": [
    "pi",
    "agent",
    "harness",
    "web",
    "plugins"
  ]
}
